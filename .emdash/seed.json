        {
          "slug": "images",
          "label": "Images",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "image",
                "type": "image",
                "label": "Image",
                "required": true
              },
              {
                "slug": "alt",
                "type": "string",
                "label": "Alt text",
                "required": true
              }
            ]
          }
