          "slug": "end_date",
          "label": "End year",
          "type": "string"
        },
        {
          "slug": "images",
          "label": "Images",
          "type": "repeater",
          "required": true,
          "validation": {
            "subFields": [
              {
                "slug": "image",
                "type": "image",
                "label": "Image",
                "required": true
              },
              {
                "slug": "alt",
                "type": "string",
                "label": "Alt text",
                "required": true
              }
            ],
            "minItems": 1
          }
        },
        {
          "slug": "banner",
          "label": "Banner",
          "type": "image",
          "required": true
        },
        {
          "slug": "preview",
          "label": "Hover preview",
          "type": "image",
          "required": true
        },
        {
          "slug": "description_en",
          "label": "Description (EN)",
          "type": "text",
          "required": true,
          "searchable": true,
          "options": {
            "rows": 8
          }
        },
        {
          "slug": "description_pt",
          "label": "Description (PT)",
          "type": "text",
          "required": true,
          "searchable": true,
          "options": {
            "rows": 8
          }
        }
