---
import { localePath, switchLocalePath } from "../i18n/routes";
import { defaultLocale, type Locale } from "../i18n/ui";
import MainHead from "./MainHead.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { title, description, locale = defaultLocale } = Astro.props;

const nav = [
  { href: localePath(locale, "/about"), key: "about" },
  { href: localePath(locale, "/projects"), key: "projects" },
];
const other: Locale = locale === "pt" ? "en" : "pt";
---

<!doctype html>
<html lang={locale === "pt" ? "pt-PT" : "en"}>
  <head>
    <MainHead title={title} description={description} locale={locale} />
  </head>
  <body class="font-primary text-dark">
    <header class="flex items-center justify-between p-6 lg:px-16">
      <a href={localePath(locale)} class="tracking-widest lowercase">a de alma</a>
      <nav class="flex gap-6 lowercase">
        {nav.map((item) => <a href={item.href}>{item.key}</a>)}
        <a href={switchLocalePath(other, Astro.url.pathname)} class="uppercase">{other}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
