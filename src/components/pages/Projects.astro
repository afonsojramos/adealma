---
import { getCopy, getProjects } from "../../content";
import { localePath } from "../../i18n/routes";
import { t, type Locale } from "../../i18n/ui";
import MainLayout from "../../layouts/MainLayout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
// toSorted keeps the imported JSON array intact: module scope is reused across
// requests in a Worker.
const projects = getProjects().toSorted((a, b) => Number(b.date) - Number(a.date));
---

<MainLayout title={copy.projects_title} locale={locale}>
  <section class="p-6 lg:px-16">
    <h1 class="text-3xl lowercase">{copy.projects_title}</h1>
    {copy.projects_description.map((paragraph) => <p class="max-w-2xl pt-6">{paragraph}</p>)}

    <ul class="grid gap-8 pt-10 md:grid-cols-3">
      {
        projects.map((project) => (
          <li>
            <a href={localePath(locale, `/projects/${project.slug}`)} class="block">
              <img
                src={`/images/${project.images[0]?.filename}.webp`}
                alt={project.images[0]?.alt}
                width="800"
                height="600"
                loading="lazy"
              />
              <h2 class="pt-3 lowercase">{project.title}</h2>
              <p class="text-sm">
                {t(locale, "location")}: {project.location}
              </p>
              <p class="text-sm">
                {t(locale, "status")}: {t(locale, project.status)}
              </p>
              <p class="text-sm">
                {t(locale, "year")}:{" "}
                {project.endDate ? `${project.date} - ${project.endDate}` : project.date}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>
