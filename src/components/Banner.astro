---
import A from "../assets/icons/a.svg";
import Alma from "../assets/icons/alma.svg";
import De from "../assets/icons/de.svg";

const common = "fixed -z-10 h-20 xl:h-48 lg:h-40 md:h-32 sm:h-24";
---

<A class={`top-6 left-6 lg:left-8 xl:left-12 2xl:left-16 ${common}`} />
<De class={`right-6 bottom-[40%] lg:right-8 xl:right-12 2xl:right-16 ${common}`} />
<Alma
  class={`bottom-6 left-6 lg:inset-x-1/2 lg:-ml-80 lg:bottom-8 xl:bottom-12 2xl:bottom-16 ${common}`}
/>
