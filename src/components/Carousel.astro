---
import type { ProjectImage } from "../content";
import { SLOTS, slotImage } from "../image";

interface Props {
  images: ProjectImage[];
}

const { images } = Astro.props;
---

<div class="flex w-screen flex-row items-center px-5">
  <swiper-container class="w-full" init="false" data-carousel>
    {
      images.map(({ image, alt }) => (
        <swiper-slide>
          <img
            src={slotImage(image.src, "carousel")}
            alt={alt}
            width={SLOTS.carousel.width}
            height={SLOTS.carousel.height}
            class="object-cover"
          />
        </swiper-slide>
      ))
    }
  </swiper-container>
</div>

<style>
  swiper-container:not([data-ready]) {
    display: flex;
    gap: 16px;
    overflow: hidden;
  }

  swiper-container:not([data-ready]) swiper-slide {
    flex: 0 0 100%;
  }

  @media (min-width: 640px) {
    swiper-container:not([data-ready]) swiper-slide {
      flex: 0 0 calc((100% - 32px) / 3);
    }
  }
</style>

<script>
  import { register } from "swiper/element/bundle";

  register();

  for (const element of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    Object.assign(element, {
      spaceBetween: 16,
      slidesPerView: 1,
      breakpoints: { 640: { slidesPerView: 3 } },
      pagination: { clickable: true },
      rewind: true,
      autoplay: { delay: 5000 },
    });
    // @ts-expect-error initialize is added by the Swiper custom element
    element.initialize();
    element.setAttribute("data-ready", "");
  }
</script>
