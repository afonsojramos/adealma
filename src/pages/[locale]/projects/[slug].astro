---
import Project from "../../../components/pages/Project.astro";
import { getProjects } from "../../../content";
import { isLocale } from "../../../i18n/ui";
import { notFound } from "../../../not-found";

const { locale, slug } = Astro.params;

if (!isLocale(locale)) {
  return notFound(Astro.rewrite);
}

const project = (await getProjects(Astro.locals, locale)).find((entry) => entry.slug === slug);

if (!project) {
  return notFound(Astro.rewrite);
}
---

<Project locale={locale} project={project} />
